# ============================================================
# Androd_Auto_Test Appium WebView 自动化环境配置模板
# 使用方式：
#   macOS:  cp .env.example .env
#   Windows: copy .env.example .env
# 然后只修改【需要你修改】标记的字段即可。
# ============================================================

# ------------------------------------------------------------
# 1. Appium / ADB 配置
# ------------------------------------------------------------
# 【通常不用改】adb 命令路径。adb 已在 PATH 中时保持 adb 即可。
# 如果 doctor 提示找不到 adb，可填写完整路径，例如：
#   macOS: /Users/你的用户名/Library/Android/sdk/platform-tools/adb
#   Windows: C:\Users\ctz\AppData\Local\Android\Sdk\platform-tools\adb.exe
ADB_PATH=adb

# 【通常不用改】Appium 服务地址
APPIUM_HOST=127.0.0.1

# 【通常不用改】Appium 服务端口
APPIUM_PORT=4723

# 【推荐保持 false】false = 手动执行 pnpm run appium 启动 Appium；true = wdio 自动拉起 Appium
# 初次调试建议 false，方便单独查看 Appium 日志。
START_APPIUM=false


# ------------------------------------------------------------
# 2. Android 设备配置
# ------------------------------------------------------------
# 【需要你修改】设备名。可通过 adb devices 查看，例如：emulator-5554、R5CTxxxxxxx
ANDROID_DEVICE_NAME=emulator-5554

# 【需要你修改】Android 系统版本，例如：13、14、15。
# 不确定时可先保留，或执行：adb shell getprop ro.build.version.release
ANDROID_PLATFORM_VERSION=14


# ------------------------------------------------------------
# 3. 被测 App 配置
# ------------------------------------------------------------
# 【需要你修改】App 包名，例如：com.example.cxapp
# 可通过以下命令辅助查看：
#   macOS:  adb shell pm list packages | grep -i 你的关键字
#   Windows: adb shell pm list packages | findstr /i 你的关键字
ANDROID_APP_PACKAGE=com.example.cxapp

# 【需要你修改】启动 Activity，例如：.MainActivity 或 com.example.cxapp.MainActivity
# 可通过以下命令辅助查看当前启动 Activity：
#   macOS:  adb shell dumpsys window | grep -E "mCurrentFocus|mFocusedApp"
#   Windows: adb shell dumpsys window | findstr mCurrentFocus
ANDROID_APP_ACTIVITY=.MainActivity

# 【通常不用改】是否保留 App 数据。
# false = 每次会话不强制保留；true = 保留 App 数据。
ANDROID_NO_RESET=true

# 【推荐 true】session 结束/重置时尽量不额外停止 App，减少 DELETE /session 阶段等待。
ANDROID_DONT_STOP_APP_ON_RESET=true

# 【通常不用改】是否完全重置安装。
# 第一版不建议 true，避免每次卸载/重装带来额外变量。
ANDROID_FULL_RESET=false

# 【推荐 true】自动授予运行时权限。
ANDROID_AUTO_GRANT_PERMISSIONS=true

# 【推荐 true】关闭系统窗口动画，提升 Appium 操作稳定性和速度。
ANDROID_DISABLE_WINDOW_ANIMATION=true

# 【推荐 true】不让 Appium 持续捕获 logcat，减少 session 结束时等待。
# 失败时脚本仍会通过 adb shell logcat -d 兜底采集日志。
APPIUM_SKIP_LOGCAT_CAPTURE=true

# 【推荐 180】Appium session 空闲超时。不要太低，避免 deleteSession 时触发二次清理。
ANDROID_NEW_COMMAND_TIMEOUT_SECONDS=180

# 【推荐 10000】UiAutomator2 server 单次 HTTP 响应超时。
# 用于避免 DELETE /session 时长时间卡在删除 UiAutomator2 server session。
UIAUTOMATOR2_SERVER_READ_TIMEOUT_MS=10000

# 【推荐 true】测试结束后快速收尾，减少 deleteSession 等待。
FAST_TEARDOWN=true

# 【默认 false】测试结束后不再主动 force-stop App；运行前 reset 会清理残留。
# 如果你确实希望结束后立即停 App，可改为 true。
POST_RUN_FORCE_STOP_APP=false

# 【预留】adb forward 由下次 pre-run-reset 清理，这里保留配置位。
POST_RUN_REMOVE_ADB_FORWARDS=true


# ------------------------------------------------------------
# 4. WebView / Chromedriver 配置
# ------------------------------------------------------------
# 【通常不用改】Appium 查找 WebView Context 的关键字。
WEBVIEW_CONTEXT_PATTERN=WEBVIEW

# 【通常不用改】等待 WebView Context 出现的超时时间。
WEBVIEW_CONTEXT_TIMEOUT_MS=30000

# 【推荐 20000】单个 WebDriver 命令请求超时。越小，deleteSession 卡住时越快失败退出。
WEBDRIVER_CONNECTION_RETRY_TIMEOUT_MS=20000

# 【可选】Chromedriver 目录。
# 如果 Appium 自动匹配 Chromedriver 失败，再填写本地 chromedriver 目录。
# 路径示例：
#   macOS: CHROMEDRIVER_EXECUTABLE_DIR=/Users/你的用户名/chromedrivers
#   Windows: CHROMEDRIVER_EXECUTABLE_DIR=E:\chromedrivers
CHROMEDRIVER_EXECUTABLE_DIR=


# ------------------------------------------------------------
# 5. 测试账号与验证码
# ------------------------------------------------------------
# 【通常不用改】测试环境固定验证码。
# cx-agent local/dev 或 SMS_USE_FIXED_CODE=true 时通常为 123。
SMS_FIXED_CODE=123

# 【需要你修改】主测试账号 A。
# 强烈建议使用：active 状态、已完成个人资料、登录后直接进入 /chat 的测试账号。
# 如果该账号登录后进入 /profile，Chat、登出、软键盘等用例会失败。
TEST_PHONE_A=13300000000

# 【后续用例需要】第二测试账号 B，用于切账号缓存隔离等场景。
TEST_PHONE_B=13300000001

# 【Profile 首次资料用例需要】未完善资料的新账号。
# 固定手机号模式：直接填写 TEST_PHONE_NEEDS_PROFILE。
# 自动递增模式：保持 TEST_PHONE_NEEDS_PROFILE 为空，打开 TEST_PHONE_NEEDS_PROFILE_AUTO_INCREMENT。
TEST_PHONE_NEEDS_PROFILE=

# 【推荐 true】每个需要“未完善资料新账号”的用例执行前自动给 TEST_PHONE_NEEDS_PROFILE 分配一个新手机号。
# 适用于测试环境固定验证码/不会真实发送短信的场景。首次使用 TEST_PHONE_NEEDS_PROFILE_BASE，之后每次新账号用例执行前 +1。
TEST_PHONE_NEEDS_PROFILE_AUTO_INCREMENT=true

# 【需要你按测试号段确认】自动递增起始手机号。必须满足后端手机号正则：1[3-9] + 9位数字。
# 示例：19900010000 -> 下次运行 19900010001 -> 再下次 19900010002。
TEST_PHONE_NEEDS_PROFILE_BASE=19900010000

# 【通常不用改】自动递增状态文件。已加入 .gitignore。
TEST_PHONE_NEEDS_PROFILE_STATE_FILE=.test-state/phone-sequence.json

# 【材料空态账号，可自动递增】用于减少 CX-MAT-002/CX-MAT-011 skipped。
# 自动递增时不需要填写 TEST_PHONE_MATERIALS_EMPTY；脚本会用新账号并自动补全基础个人资料。
TEST_PHONE_MATERIALS_EMPTY=
TEST_PHONE_MATERIALS_EMPTY_AUTO_INCREMENT=true
TEST_PHONE_MATERIALS_EMPTY_BASE=19900020000

# 【材料沟通卡账号，可自动递增】用于减少 CX-MAT-003/004/005/007/008/016 skipped。
# 脚本会自动补全基础个人资料，并通过业务接口准备一张“自动化沟通卡”。
TEST_PHONE_MATERIALS_CARD=
TEST_PHONE_MATERIALS_CARD_AUTO_INCREMENT=true
TEST_PHONE_MATERIALS_CARD_BASE=19900030000

# 【未授权健康档案账号，可自动递增】用于减少 CX-CONSENT-001/CX-CONSENT-003 skipped。
# 脚本只补全基础个人资料，不会预先同意 health_profile 授权。
TEST_PHONE_NO_HEALTH_CONSENT=
TEST_PHONE_NO_HEALTH_CONSENT_AUTO_INCREMENT=true
TEST_PHONE_NO_HEALTH_CONSENT_BASE=19900040000

# 【清空健康档案专项账号，可自动递增】用于 CX-MED-026。
# 该用例会真实调用“清空健康档案”，请使用专用账号或保持自动递增。
TEST_PHONE_MEDICAL_PURGE=
TEST_PHONE_MEDICAL_PURGE_AUTO_INCREMENT=true
TEST_PHONE_MEDICAL_PURGE_BASE=19900050000

# 【后续用例需要】注销冷静期账号，用于 pending_deletion 专项。
TEST_PHONE_PENDING=13800000003


# ------------------------------------------------------------
# 6. 运行行为
# ------------------------------------------------------------
# 【推荐 true】每次测试运行创建 Appium session 前，先清理 App 状态和残留进程。
# 会执行：adb force-stop、pm clear、再次 force-stop，并记录 reports/runs/.../pre-run-reset.json
RESET_APP_BEFORE_RUN=true

# 【推荐 true】运行前清 App 数据。关闭后仅 force-stop，不清 localStorage/token。
RESET_APP_CLEAR_DATA_BEFORE_RUN=true

# 【推荐 true】运行前清理 adb forward，避免上次 Chromedriver/WebView socket 残留。
RESET_ADB_FORWARDS_BEFORE_RUN=true

# 【通常不用改】reset 后等待 App 进程完全退出的时间。
RESET_APP_WAIT_MS=2000

# 【兼容旧配置】单个 spec 内额外清理 App 数据；已有 RESET_APP_BEFORE_RUN，一般保持 false。
CLEAR_APP_BEFORE_SUITE=false

# 【推荐 true】失败时采集 logcat。
RECORD_LOGCAT=true

# 【暂未强制清理】历史 reports/runs 保留数量，后续可用于自动清理。
REPORT_KEEP_RUNS=30

# 【可选】写入 summary.json 的套件名称。
TEST_SUITE_NAME=webview-p0-fast

# 【推荐 true】自动准备可快速验证的前置数据，减少 skipped。
# true = 沟通卡详情/编辑类用例运行前自动造一张沟通卡。
SEED_COMMUNICATION_CARD_BEFORE_CASES=true

# 【推荐 true】使用自动递增的空材料账号验证材料空态，避免主账号已有材料导致 skipped。
USE_DYNAMIC_EMPTY_MATERIALS_ACCOUNT=true

# 【推荐 true】使用自动递增的未授权账号验证健康授权首次弹窗/拒绝流程。
USE_DYNAMIC_NO_HEALTH_CONSENT_ACCOUNT=true

# 【推荐 true】进入健康档案 fast 用例前，把测试账号个人资料调整为“女 + 乳腺肿瘤相关诊疗”，
# 这样月经状态、肿瘤分型、确诊时长、治疗阶段、用药情况、用药时长等字段都会可见。
ENSURE_KNOWN_MEDICAL_PROFILE_FOR_FAST_CASES=true

# 【默认 false】是否启用“关闭重启 App 后保持登录态”用例。
# 该用例会在 Appium session 中 force-stop/重新启动 App，部分 WebView/Chromedriver 组合容易造成 session/context 不稳定。
# 默认跳过；需要专项验证 CX-WV-BASE-012 时改为 true 后单独运行 webview 或 all。
RESTART_APP_CASE_ENABLED=false

# 【默认 16】CX-CHAT-025 为验证“超过 30 条消息上滑加载更早历史”，会在专用临时会话里发送 N 轮 sync 消息。
# 16 轮 = 32 条消息，能触发初始 limit=30 后的更早消息加载；调小到 0~15 时该用例会 skipped。
CHAT_LONG_HISTORY_TURNS=16
